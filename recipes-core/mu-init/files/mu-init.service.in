[Unit]
Description=mu-init update checker
After=mu-update-daemon.service
Requires=mu-update-daemon.service

[Service]
Type=oneshot
Environment=UPDATE_INBOX_DIR=@MU_UPDATE_INBOX_DIR@
ExecStart=/usr/libexec/mu-init/mu-init.sh
User=root
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
